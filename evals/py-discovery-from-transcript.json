{
  "name": "py-discovery-from-transcript",
  "cwd": "examples/python-api",
  "tags": [
    "loop",
    "discovery"
  ],
  "description": "/sdlc-discovery on a first meeting (VTT with timestamps, no tracker): registers the source, records the new photo upload as requested and missing, sees that filtering by status already exists in the code, files the open question, the client's action item, the decision and the privacy risk with quoted evidence, and leaves the code alone.",
  "setup": "cp \"$EVAL_DIR/fixtures/discovery/weekly-sync-2026-09-14.vtt\" weekly-sync-2026-09-14.vtt && \"$EVAL_DIR/fixtures/commit.sh\" 'eval setup: transcript'",
  "prompt": "/sdlc-discovery weekly-sync-2026-09-14.vtt (the meeting is the \"Weekly sync\" with Northwind; Sam is on our team, Dana and Lee are the client). Headless run: do not ask questions. Do not commit.",
  "allowed_tools": "Read,Write,Edit,Grep,Glob,Bash(ls:*),Bash(git status),Bash(git grep:*),Bash(git show:*),Bash(.sdlc/bin/sdlc:*)",
  "checks": [
    {
      "type": "command",
      "run": ".sdlc/bin/sdlc discovery validate",
      "why": "closed statuses, evidence that cites the source, owners on a side"
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/_sources.md",
      "pattern": "^\\| 2026-09-14 \\| Weekly sync \\|",
      "why": "the meeting is registered once, with its date"
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/topics/*.md",
      "pattern": "^\\| F\\d+ \\|[^|]*photo[^|]*\\| requested \\| missing \\|",
      "ignore_case": true,
      "why": "photo upload is new: nothing in the code"
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/topics/*.md",
      "pattern": "^\\| F\\d+ \\|[^|]*status[^|]*\\| (done|requested|in progress) \\| (exists|partial) \\|",
      "ignore_case": true,
      "why": "list_claims already filters by status: checked against the code, not taken at face value"
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/topics/*.md",
      "pattern": "^\\| Q\\d+ \\|[^|]*(size|MB)[^|]*\\| Client: Dana[^|]*\\| open \\| 2026-09-14 \\|",
      "ignore_case": true,
      "why": "the open question goes to whoever must answer it"
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/topics/*.md",
      "pattern": "^\\| A\\d+ \\|[^|]*photo[^|]*\\| Client: Dana[^|]*\\| (open|scheduled) \\|",
      "ignore_case": true,
      "why": "the client owes the sample photos"
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/topics/*.md",
      "pattern": "^\\| D\\d+ \\|[^|]*(manual review|10,?000|ten thousand)",
      "ignore_case": true
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/topics/*.md",
      "pattern": "^\\| R\\d+ \\|[^|]*(face|privacy|personal|legal|stor)",
      "ignore_case": true
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/topics/*.md",
      "pattern": "2026-09-14 Weekly sync · (\\d{2}:)?\\d{1,2}:\\d{2} · Dana",
      "why": "evidence carries the timestamp and the speaker"
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/STATUS.md",
      "pattern": "^\\*\\*Last source:\\*\\* 2026-09-14 Weekly sync",
      "why": "STATUS.md regenerated by the CLI"
    },
    {
      "type": "file_matches",
      "glob": "changes/_discovery/followups/*.md",
      "pattern": "(size|MB)",
      "ignore_case": true,
      "why": "the follow-up asks the client the open question"
    },
    {
      "type": "diff_excludes",
      "glob": "src/**",
      "why": "discovery does not touch code"
    },
    {
      "type": "output_matches",
      "pattern": "(already|exists)",
      "why": "the report flags the request that is already built"
    }
  ]
}
