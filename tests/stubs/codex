#!/usr/bin/env bash
# codex stub: logs args to $STUB_LOG; writes its final answer to --output-last-message.
printf 'codex %s\n' "$*" >> "$STUB_LOG"
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    --output-last-message) out="$2"; shift 2 ;;
    *) shift ;;
  esac
done
echo "progress noise on stdout"
[ -n "$out" ] && printf '## Automated review (ai-sdlc)\n\nImportant: 0 · Nit: 2\n' > "$out"
exit 0
