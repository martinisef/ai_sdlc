#!/usr/bin/env bash
# claude stub: logs args to $STUB_LOG and answers by prompt type (the prompt follows -p).
printf 'claude %s\n' "$*" >> "$STUB_LOG"
# $STUB_ACCOUNT_ERROR: fail like a provider that refuses the account (no quota, bad key)
if [ -n "$STUB_ACCOUNT_ERROR" ]; then echo "ERROR: $STUB_ACCOUNT_ERROR" >&2; exit 1; fi
prompt="$2"
case "$prompt" in
  *"review finder"*)
    # $STUB_FINDINGS / $STUB_SECURITY (files) replace the answer of the Bugs / Injection pass (or the single Quick pass);
    # other passes find nothing
    case "$prompt" in
      *"pass: Injection"*|*"pass: every security"*)
        if [ -n "$STUB_SECURITY" ]; then cat "$STUB_SECURITY"
        else printf '[{"severity":"nit","file":"src/a.py","line":4,"title":"index from the request is not bounded","evidence":"xs[i] with i from input","bug_class":"path traversal"}]\n'
        fi ;;
      *"pass: Bugs"*|*"pass: every pass"*)
        if [ -n "$STUB_FINDINGS" ]; then cat "$STUB_FINDINGS"
        else printf '[{"severity":"important","file":"src/a.py","line":3,"title":"off by one","evidence":"range(len(xs) + 1) reads past the end","bug_class":"off-by-one"},{"severity":"nit","file":"src/a.py","line":5,"title":"rename x to count","evidence":"","bug_class":"naming"}]\n'
        fi ;;
      *) echo '[]' ;;
    esac ;;
  *"review verifier"*)
    # keep every new candidate except the ids in $STUB_DROP; earlier findings are fixed if listed in $STUB_FIXED
    votes=""
    for id in $(printf '%s\n' "$prompt" | grep '^New candidates:' | grep -o '"id":"f[0-9]*"' | cut -d'"' -f4); do
      case " $STUB_DROP " in *" $id "*) v=drop ;; *) v=keep ;; esac
      votes="$votes{\"id\":\"$id\",\"vote\":\"$v\"},"
    done
    for id in $(printf '%s\n' "$prompt" | grep '^Findings still open' | grep -o '"id":"f[0-9]*"' | cut -d'"' -f4); do
      case " $STUB_FIXED " in *" $id "*) v=fixed ;; *) v=open ;; esac
      votes="$votes{\"id\":\"$id\",\"vote\":\"$v\"},"
    done
    printf 'Checked.\n```json\n[%s]\n```\n' "${votes%,}" ;;
  *"second risk classifier"*)
    printf 'It changes when sessions expire.\nESCALATE: high — session expiry is an auth boundary\n' ;;
  *"build log"*)
    printf '## Automated triage (ai-sdlc)\nLooks flaky: network timeout in setup.\n' ;;
  *"mentioned you"*)
    # "WRITE <path>" in the comment: edit and commit it (only reachable with ci.mention_mode edit)
    f="$(printf '%s' "$prompt" | sed -n 's/.*WRITE \([^ ]*\).*/\1/p' | head -1)"
    if [ -n "$f" ] && [ "$4" != "Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*)" ]; then
      echo changed > "$f" && git add "$f" && git -c user.email=bot@ci -c user.name=bot commit -qm "fix: $f"
      echo "Changed $f as asked."
    else
      echo "The guard on line 3 is inverted; flip the comparison."
    fi ;;
  *sdlc-spec*)
    d="$(printf '%s' "$prompt" | grep -Eo 'changes/[a-z0-9-]+' | head -1)"
    printf -- '---\nstatus: draft\n---\n# Spec\n' > "$d/spec.md"
    git add "$d/spec.md" && git -c user.email=bot@ci -c user.name=bot commit -qm "spec: $d" ;;
  *)
    # evals: "WRITE <path>" in the prompt creates that file
    f="$(printf '%s' "$prompt" | sed -n 's/.*WRITE \([^ ]*\).*/\1/p')"
    [ -n "$f" ] && mkdir -p "$(dirname "$f")" && echo changed > "$f"
    echo "done; all tests pass" ;;
esac
exit 0
