#!/usr/bin/env bash
# Cursor CLI stub (`agent`): logs args to $STUB_LOG; answers on stdout like `agent -p --output-format text`.
[ "$1" = "--version" ] && { echo "2026.10.1"; exit 0; }
printf 'agent %s\n' "$*" >> "$STUB_LOG"
case "${@: -1}" in
  *"review finder"*) echo '[{"severity":"important","file":"src/c.py","line":2,"title":"unchecked None","bug_class":"null dereference"}]' ;;
  *) echo '[]' ;;
esac
exit 0
